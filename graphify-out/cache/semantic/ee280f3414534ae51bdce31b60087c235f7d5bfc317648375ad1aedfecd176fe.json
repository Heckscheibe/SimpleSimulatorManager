{"nodes": [{"id": "simulatormanagertests_readme_testing_architecture", "label": "Protocol-Abstraction Testing Architecture", "file_type": "concept", "source_file": "SimulatorManagerTests/README.md", "source_location": "Testing Architecture", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Protocol abstractions were introduced for the main dependencies specifically to enable unit testing of SimulatorManagerViewModel without touching the filesystem."}, {"id": "simulatormanagertests_readme_devicemanagerprotocol", "label": "DeviceManagerProtocol", "file_type": "concept", "source_file": "SimulatorManagerTests/README.md", "source_location": "Protocols and Abstractions", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Documented name for the device-management interface; the code seam is DeviceManaging in SimulatorManager/DeviceManager.swift, so the doc name is stale relative to the source."}, {"id": "simulatormanagertests_readme_deviceappmonitoringserviceprotocol", "label": "DeviceAppMonitoringServiceProtocol", "file_type": "concept", "source_file": "SimulatorManagerTests/README.md", "source_location": "Protocols and Abstractions", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Documented name for the app-monitoring interface; the code seam is DeviceAppMonitoring in SimulatorManager/Services/DeviceAppMonitoringService.swift, so the doc name is stale relative to the source."}, {"id": "simulatormanagertests_readme_mockdevicemanager", "label": "MockDeviceManager Test Double", "file_type": "concept", "source_file": "SimulatorManagerTests/README.md", "source_location": "Mock Implementations", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Supplies controllable test data through CurrentValueSubject publishers and records method calls, so tests can drive Combine flows deterministically and verify interactions."}, {"id": "simulatormanagertests_readme_mockdeviceappmonitoringservice", "label": "MockDeviceAppMonitoringService Test Double", "file_type": "concept", "source_file": "SimulatorManagerTests/README.md", "source_location": "Mock Implementations", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A deliberately lightweight mock focused on behavioral verification \u2014 it only tracks method calls rather than simulating FSEvents monitoring."}, {"id": "simulatormanagertests_readme_testdatahelpers", "label": "TestDataHelpers Factory Methods", "file_type": "concept", "source_file": "SimulatorManagerTests/README.md", "source_location": "Test Data Helpers", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An enum of factory methods for mock devices, device types, apps, app changes and pre-configured scenarios, used so test data stays consistent across suites."}, {"id": "simulatormanagertests_readme_waiting_for_async_state", "label": "Wait for Condition, Not for Duration", "file_type": "rationale", "source_file": "SimulatorManagerTests/README.md", "source_location": "Testing Patterns", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "State arriving via Combine's .receive(on: DispatchQueue.main) or a detached Task has not landed when the triggering call returns. A fixed Task.sleep is a guess that a loaded machine or a parallel test run can outrun, producing intermittent failures that are hard to reproduce \u2014 so tests poll the exposed state with waitUntil and a generous timeout instead. CleanupSimulatorsViewModelTests polls the view model's own progress flags; SettingsMenuVisibilityTests drains main-queue turns for Combine bindings."}, {"id": "simulatormanagertests_readme_require_over_expect_for_subscripts", "label": "Guard Subscripts with #require, Not #expect", "file_type": "rationale", "source_file": "SimulatorManagerTests/README.md", "source_location": "Testing Patterns", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "#expect records a failure and keeps going, so it cannot guard a subscript. An out-of-range Array subscript is a fatal Swift trap that kills the test host process and every test running alongside it; try #require throws and ends only the failing test. The same applies to !-unwrapping and try! inside assertions."}, {"id": "simulatormanagertests_readme_call_verification", "label": "Mock Call Verification Pattern", "file_type": "concept", "source_file": "SimulatorManagerTests/README.md", "source_location": "Testing Patterns", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mocks expose flags and last-argument captures (e.g. updateSpecificDeviceCalled, lastUpdatedDevice) so tests assert on both state changes and the interaction that produced them."}, {"id": "simulatormanagertests_readme_concurrent_testing", "label": "Concurrent Access Testing with TaskGroup", "file_type": "concept", "source_file": "SimulatorManagerTests/README.md", "source_location": "Testing Patterns", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "withTaskGroup drives simultaneous operations to exercise concurrent access patterns against main-actor view models."}, {"id": "simulatormanagertests_readme_isolation_benefits", "label": "Filesystem-Free Test Isolation", "file_type": "rationale", "source_file": "SimulatorManagerTests/README.md", "source_location": "Benefits of This Approach", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mocking the dependencies buys isolation from the filesystem and external services, full control over data and timing, fast I/O-free execution, deterministic outcomes, and room to cover edge cases that real simulators cannot be forced into."}, {"id": "simulatormanagertests_readme_best_practices", "label": "Test Suite Best Practices", "file_type": "concept", "source_file": "SimulatorManagerTests/README.md", "source_location": "Best Practices", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use TestDataHelpers factories, wait for conditions rather than durations, guard every subscript with try #require, reset mock state between tests for isolation, cover happy path and edge cases, verify both state and calls, and name tests after the scenario."}, {"id": "simulatormanagertests_readme_file_organization", "label": "Test Target File Organization", "file_type": "document", "source_file": "SimulatorManagerTests/README.md", "source_location": "File Organization", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mocks/, Helpers/, ViewModels/ and Protocols/ subdirectories keep separation of concerns and make it obvious where a new mock or fixture belongs."}, {"id": "simulatormanagertests_readme_simulatormanagerviewmodeltests", "label": "SimulatorManagerViewModelTests Primary Suite", "file_type": "concept", "source_file": "SimulatorManagerTests/README.md", "source_location": "Test Structure", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Covers initialization and binding behavior, reactive data flow through Combine publishers, integration between the view model and its injected dependencies, and memory management verification."}, {"id": "simulatormanagertests_readme_simulatormanagerviewmodeledgecasetests", "label": "SimulatorManagerViewModelEdgeCaseTests Suite", "file_type": "concept", "source_file": "SimulatorManagerTests/README.md", "source_location": "Test Structure", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Extends the primary suite with edge cases and error conditions, performance scenarios such as large datasets and rapid updates, concurrent access patterns, and platform-specific scenarios \u2014 kept separate so the primary suite stays readable."}, {"id": "simulatormanagertests_readme_devicemanagerprotocoltests", "label": "DeviceManagerProtocolTests Conformance Suite", "file_type": "concept", "source_file": "SimulatorManagerTests/README.md", "source_location": "Test Structure", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verifies that concrete types conform to the protocols, validates mock behavior, and integration-tests against actual protocol instances so the mocks cannot drift from the real implementations. No matching file exists under SimulatorManagerTests/Protocols/ in the current tree."}], "edges": [{"source": "simulatormanagertests_readme_testing_architecture", "target": "simulatormanager_viewmodels_simulatormanagerviewmodel_simulatormanagerviewmodel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SimulatorManagerTests/README.md", "source_location": "Overview", "weight": 1.0}, {"source": "simulatormanagertests_readme_devicemanagerprotocol", "target": "simulatormanager_devicemanager_devicemanaging", "relation": "references", "confidence": "AMBIGUOUS", "confidence_score": 0.3, "source_file": "SimulatorManagerTests/README.md", "source_location": "Protocols and Abstractions", "weight": 1.0}, {"source": "simulatormanagertests_readme_deviceappmonitoringserviceprotocol", "target": "simulatormanager_services_deviceappmonitoringservice_deviceappmonitoring", "relation": "references", "confidence": "AMBIGUOUS", "confidence_score": 0.3, "source_file": "SimulatorManagerTests/README.md", "source_location": "Protocols and Abstractions", "weight": 1.0}, {"source": "simulatormanagertests_readme_mockdevicemanager", "target": "simulatormanagertests_mocks_mockdevicemanager_mockdevicemanager", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "SimulatorManagerTests/README.md", "source_location": "Mock Implementations", "weight": 1.0}, {"sourc