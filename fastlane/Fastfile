# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

# App and archive names
APP_NAME = "Simulator Manager"
ZIP_NAME = "SimulatorManager"
# Keep in sync with fastlane/Matchfile's app_identifier(...) — Matchfile is also loaded
# standalone (e.g. `fastlane match developer_id` from the CLI), so it can't read this constant.
APP_IDENTIFIER = "com.nicolashiller.SimpleSimulatorManager"
# Keep in sync with fastlane/Matchfile's type(...), same reason as APP_IDENTIFIER above.
MATCH_TYPE = "developer_id"
PROJECT_ROOT = File.expand_path("..", __dir__)
BUILD_DIR = File.join(PROJECT_ROOT, "build")
RELEASE_DIR = File.join(PROJECT_ROOT, "release")
PROJECT_FILE = File.join(PROJECT_ROOT, "SimulatorManager.xcodeproj")
# The MCP server reports the app's version; SwiftPM can't read MARKETING_VERSION, so the release
# lane writes it into this constant too.
MCP_SERVER_VERSION_FILE = File.join(PROJECT_ROOT, "Packages/SimulatorCore/Sources/SimulatorMCPServer/SimulatorMCPServer.swift")
GITHUB_REPO = "Heckscheibe/SimpleSimulatorManager"

require "shellwords"
require_relative "release_notes"

# Homebrew tap (Heckscheibe/homebrew-tap). Defaults to a clone sitting next to this
# repo; override with HOMEBREW_TAP_PATH. The cask is updated locally and pushed using
# the maintainer's own git credentials, so no CI secret is required.
HOMEBREW_TAP_PATH = ENV["HOMEBREW_TAP_PATH"] || File.expand_path("homebrew-tap", File.dirname(PROJECT_ROOT))
HOMEBREW_CASK_FILE = File.join(HOMEBREW_TAP_PATH, "Casks", "simple-simulator-manager.rb")

# Shared App Store Connect API key, used both for notarization and to authenticate `match`
# against the Apple Developer Portal (no Apple ID/password login, no interactive 2FA prompt).
# Memoized: a single `fastlane mac release` run calls this both indirectly (via
# sync_signing_assets/match, inside `build`) and directly (for `notarize`) — no need to
# re-validate env vars, re-read the .p8 file, and rebuild the auth token twice per run.
def app_store_connect_key
  @app_store_connect_key ||= begin
    key_id = ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"].to_s.strip
    issuer_id = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"].to_s.strip
    key_filepath = ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"].to_s.strip

    missing = []
    missing << "APP_STORE_CONNECT_API_KEY_KEY_ID" if key_id.empty?
    missing << "APP_STORE_CONNECT_API_KEY_ISSUER_ID" if issuer_id.empty?
    missing << "APP_STORE_CONNECT_API_KEY_KEY_FILEPATH" if key_filepath.empty?

    unless missing.empty?
      UI.user_error!("This requires App Store Connect API key credentials. Missing: #{missing.join(', ')}")
    end

    UI.user_error!("APP_STORE_CONNECT_API_KEY_KEY_FILEPATH points to a missing file: #{key_filepath}") unless File.exist?(key_filepath)

    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_filepath
    )
  end
end

# Fetches (readonly: true, the normal build-time path) or pushes (readonly: false, the
# occasional maintenance path — see the update_signing_assets lane) the Developer ID
# certificate + provisioning profile via match, replacing manual per-machine keychain setup.
# Shared by both call sites so they can't drift apart on anything but `readonly`.
def sync_signing_assets(readonly:)
  UI.user_error!("MATCH_PASSWORD is required to decrypt signing assets from the match storage repo.") if ENV["MATCH_PASSWORD"].to_s.strip.empty?

  match(
    type: MATCH_TYPE,
    api_key: app_store_connect_key,
    readonly: readonly,
    # Only safe for the readonly fetch path — match pushes new commits when readonly is
    # false, which a shallow clone can complicate.
    shallow_clone: readonly
  )
end

# Puts the MCP server embedded in the app on the user's PATH via a `binary` stanza right after the
# `app` stanza. It is added by the first release bump that ships the helper (adding it any earlier
# would break `brew install` for releases without it) and left alone by every bump after that.
def add_mcp_binary_stanza(cask_contents)
  return cask_contents if cask_contents.include?("Contents/Helpers/simple-simulator-mcp")

  stanza = %(binary "\#{appdir}/#{APP_NAME}.app/Contents/Helpers/simple-simulator-mcp")
  updated = cask_contents.sub(/^(?<indent>[ \t]*)app "[^"]*"\n/) do |app_line|
    "#{app_line}#{Regexp.last_match[:indent]}#{stanza}\n"
  end
  UI.important("⚠️  No app stanza found in the cask; add the simple-simulator-mcp binary stanza by hand.") if updated == cask_contents
  updated
end

def release_tag(version)
  "v#{version}"
end

def release_notes_path(version)
  File.join(RELEASE_DIR, "RELEASE_NOTES-#{version}.md")
end

def release_zip_path
  File.join(RELEASE_DIR, "#{ZIP_NAME}.zip")
end

# Runs the GitHub CLI with the maintainer's own login (like the Homebrew tap push, so no CI secret
# is needed). Returns stdout; any failure becomes a lane error carrying gh's message.
def gh(*args, allow_failure: false)
  stdout, stderr, status = Open3.capture3("gh", *args, binmode: true)
  stdout.force_encoding(Encoding::UTF_8)
  stderr.force_encoding(Encoding::UTF_8)
  return status.success? if allow_failure
  UI.user_error!("`gh #{args.first(3).join(' ')} …` failed: #{stderr.strip}") unless status.success?

  stdout
rescue Errno::ENOENT
  UI.user_error!("The GitHub CLI is required to publish a release: brew install gh && gh auth login")
end

def git_output(*args)
  stdout, stderr, status = Open3.capture3("git", "-C", PROJECT_ROOT, *args, binmode: true)
  stdout.force_encoding(Encoding::UTF_8)
  stderr.force_encoding(Encoding::UTF_8)
  UI.user_error!("`git #{args.join(' ')}` failed: #{stderr.strip}") unless status.success?

  stdout.strip
end

# The commit the release tag will point at. Defaults to HEAD; GitHub can only tag a commit it has,
# so refuse one that was never pushed.
def resolve_release_target(target)
  sha = git_output("rev-parse", "--verify", "#{target || 'HEAD'}^{commit}")
  if git_output("branch", "-r", "--contains", sha).empty?
    UI.user_error!("Commit #{sha[0, 7]} is not on any remote branch. Push it first, or pass target:<branch-or-sha>.")
  end

  sha
end

# Cheap checks run before the (long) build, so a missing tool or an existing release does not
# surface after the app has already been signed and notarized.
def ensure_release_publishable(version)
  gh("auth", "status")
  tag = release_tag(version)
  if gh("release", "view", tag, "--repo", GITHUB_REPO, allow_failure: true) ||
     !git_output("ls-remote", "--tags", "origin", "refs/tags/#{tag}").empty?
    UI.user_error!("#{tag} already exists on #{GITHUB_REPO}. Pick a new version or delete the release and tag first.")
  end

  claude = ENV["CLAUDE_CLI"] || "claude"
  unless system("command -v #{Shellwords.escape(claude)} > /dev/null 2>&1")
    UI.user_error!("`#{claude}` not found. Install Claude Code (it writes the release notes) or set CLAUDE_CLI.")
  end
end

# GitHub's generated "What's Changed" lines for previous release → target, grouped and summarised
# by Claude, written to release/RELEASE_NOTES-<version>.md. Returns that path.
def generate_release_notes(version:, target:, previous_tag: nil)
  previous_tag ||= gh("release", "view", "--repo", GITHUB_REPO, "--json", "tagName", "--jq", ".tagName").strip
  UI.message("📝 Collecting pull requests #{previous_tag} → #{target[0, 7]}...")

  generated_body = gh(
    "api", "repos/#{GITHUB_REPO}/releases/generate-notes",
    "-f", "tag_name=#{release_tag(version)}",
    "-f", "previous_tag_name=#{previous_tag}",
    "-f", "target_commitish=#{target}",
    "--jq", ".body"
  )
  generated = ReleaseNotes.parse_generated(generated_body)
  UI.user_error!("No merged pull requests between #{previous_tag} and #{target[0, 7]}.") if generated.entries.empty?

  pull_requests = generated.entries.map do |entry|
    JSON.parse(gh("pr", "view", entry.number.to_s, "--repo", GITHUB_REPO, "--json", "number,title,body,labels"))
  end

  UI.message("🤖 Asking Claude to categorise and summarise #{pull_requests.size} pull requests...")
  answer = ReleaseNotes.ask_claude(ReleaseNotes.build_prompt(pull_requests))
  classification = ReleaseNotes.parse_classification(answer)
  ReleaseNotes.problems(generated, classification).each { |problem| UI.important("⚠️  #{problem}") }

  FileUtils.mkdir_p(RELEASE_DIR)
  path = release_notes_path(version)
  File.write(path, ReleaseNotes.render(generated, classification))
  path
rescue ReleaseNotes::Error => e
  UI.user_error!(e.message)
end

# Shows version, target, asset and notes; the maintainer can edit the notes before publishing.
# Returns true once the release has been created, false if the maintainer cancelled.
def confirm_and_publish_release(version:, target:, notes_path:, dry_run: false)
  zip_path = release_zip_path
  UI.user_error!("#{zip_path} not found — run the release lane first.") unless File.exist?(zip_path)

  tag = release_tag(version)
  dirty = git_output("status", "--porcelain")
  loop do
    UI.header("GitHub release #{version}")
    UI.message("Repository: #{GITHUB_REPO}")
    UI.message("Tag:        #{tag} (new) → #{target[0, 7]} #{git_output('log', '-1', '--format=%s', target)}")
    UI.message("Asset:      #{File.basename(zip_path)} (#{(File.size(zip_path) / 1024.0 / 1024.0).round(2)} MB)")
    unless dirty.empty?
      UI.important("⚠️  The working tree has uncommitted changes (e.g. the version bump). They are NOT in the tagged commit #{target[0, 7]}.")
    end
    UI.message("")
    UI.message("Release notes (#{notes_path}):")
    UI.message("─" * 60)
    puts File.read(notes_path, encoding: "UTF-8")
    UI.message("─" * 60)

    choice = UI.select("Publish release #{version}?", ["Publish", "Edit release notes", "Cancel"])
    case choice
    when "Publish" then break
    when "Edit release notes"
      editor = ENV["VISUAL"] || ENV["EDITOR"] || "open -W -t"
      system("#{editor} #{Shellwords.escape(notes_path)}")
    else
      UI.important("Release cancelled — nothing was uploaded.")
      return false
    end
  end

  create_args = [
    "release", "create", tag, zip_path,
    "--repo", GITHUB_REPO, "--title", version, "--notes-file", notes_path, "--target", target, "--latest"
  ]
  if dry_run
    UI.important("DRY RUN — would run: gh #{create_args.shelljoin}")
    return false
  end

  url = gh(*create_args).strip
  UI.success("🚀 Released #{version}: #{url}")
  true
end

default_platform(:mac)

platform :mac do
  desc "One-time/maintenance: push the Developer ID certificate + profile to the match storage " \
       "repo. Uses the App Store Connect API key, so no Apple ID/password login or 2FA prompt. " \
       "NOTE: Apple blocks *creating* a brand-new Developer ID Application certificate via API " \
       "key entirely (Account Holder only) — this lane can renew/re-push what's already in the " \
       "certs repo, or push a profile fetched/created for an existing certificate, but a " \
       "genuinely new certificate has to be created interactively and imported via " \
       "`fastlane match import`. See FASTLANE_README.md for the full walkthrough."
  lane :update_signing_assets do
    sync_signing_assets(readonly: false)
    UI.success("✅ Developer ID certificate + profile are up to date in the match storage repo.")
  end

  desc "Build and sign the macOS app for Developer ID distribution"
  lane :build do
    # Fetch the Developer ID certificate + provisioning profile via match instead of assuming
    # they're already installed in the local keychain.
    sync_signing_assets(readonly: true)

    certificate_name = ENV["sigh_#{APP_IDENTIFIER}_#{MATCH_TYPE}_macos_certificate-name"]
    profile_name = ENV["sigh_#{APP_IDENTIFIER}_#{MATCH_TYPE}_macos_profile-name"]
    UI.user_error!("match did not return a Developer ID certificate/profile for #{APP_IDENTIFIER}.") if certificate_name.to_s.empty? || profile_name.to_s.empty?

    build_mac_app(
      project: PROJECT_FILE,
      scheme: "SimulatorManager",
      configuration: "Release",
      export_method: "developer-id",
      codesigning_identity: certificate_name,
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          APP_IDENTIFIER => profile_name
        }
      },
      output_directory: BUILD_DIR,
      output_name: APP_NAME
    )
    UI.success("✅ Build completed successfully!")
  end

  desc "Set the release version, build, notarize and zip the app, write the release notes with Claude, " \
       "publish the GitHub release after confirmation, then bump the Homebrew cask"
  lane :release do
    # Ask for release version
    release_version = prompt(text: "Enter the release version (e.g. 1.2.3):")

    # Fail before the long build if the release cannot be published afterwards.
    ensure_release_publishable(release_version)

    sh("rm -rf '#{BUILD_DIR}' '#{RELEASE_DIR}'")
    
    # Bump the build number and set the version
    increment_version_number(
      xcodeproj: PROJECT_FILE,
      version_number: release_version
    )
    increment_build_number(
      xcodeproj: PROJECT_FILE
    )
    mcp_server_source = File.read(MCP_SERVER_VERSION_FILE, encoding: "UTF-8")
    version_pattern = /(public static let version = )"[^"]*"/
    UI.user_error!("SimulatorMCPServer.version not found in #{MCP_SERVER_VERSION_FILE}") unless mcp_server_source.match?(version_pattern)
    File.write(MCP_SERVER_VERSION_FILE, mcp_server_source.sub(version_pattern, "\\1\"#{release_version}\""))
    UI.success("🔢 Version set to #{release_version} (app and MCP server) and build number incremented.")

    # Build the app. If this fails — including at the new sync_signing_assets/match step,
    # which can fail on a network/git-access/MATCH_PASSWORD problem unrelated to the version
    # bump above — revert the version/build number bump rather than leaving it applied with
    # no build/zip produced.
    begin
      build
    rescue StandardError => e
      UI.error("❌ Build failed — reverting the version/build number bump on #{PROJECT_FILE} and #{MCP_SERVER_VERSION_FILE}.")
      sh("git -C '#{PROJECT_ROOT}' checkout -- '#{PROJECT_FILE}' '#{MCP_SERVER_VERSION_FILE}'")
      raise e
    end

    # The exported app is written directly to BUILD_DIR/APP_NAME.app by build_mac_app.
    # Don't glob recursively: on the case-insensitive macOS filesystem BUILD_DIR ("build")
    # collides with Xcode's archive intermediates ("Build/Intermediates.noindex/…"), so a
    # `**` glob can return an unsigned intermediate .app and break notarization.
    app_path = File.join(BUILD_DIR, "#{APP_NAME}.app")
    unless File.exist?(app_path)
      UI.error("❌ Could not find #{APP_NAME}.app for notarization at #{app_path}")
      sh("find '#{BUILD_DIR}' -maxdepth 1 -name '*.app' -type d")
      raise "App not found in build directory"
    end

    UI.message("🧾 Submitting app for notarization...")
    notarize(
      package: app_path,
      api_key: app_store_connect_key,
      print_log: true
    )
    UI.success("✅ Notarization completed successfully!")

    # Create a zip file for GitHub releases
    zip_path = File.join(BUILD_DIR, "#{ZIP_NAME}.zip")
    zip(
      path: app_path,
      output_path: zip_path
    )

    unless File.exist?(zip_path)
      UI.error("❌ Could not find #{ZIP_NAME}.zip after ZIP creation")
      sh("find '#{BUILD_DIR}' -name '*.zip' -type f")
      raise "ZIP not found in build directory"
    end

    UI.message("📦 Found ZIP at: #{zip_path}")

    # Copy files to a release directory
    sh("mkdir -p '#{RELEASE_DIR}'")
    sh("cp '#{zip_path}' '#{File.join(RELEASE_DIR, "#{ZIP_NAME}.zip")}'")

    UI.success("🎉 Build and notarization completed successfully!")
    UI.message("Files available in ./release/:")
    UI.message("- #{ZIP_NAME}.zip (notarized)")
    UI.message("")

    # Publish before touching the cask: the cask URL points at this release's asset, so it must
    # exist by the time `brew install` can see the new version. If the maintainer cancels, the
    # cask is left alone.
    if github_release(version: release_version)
      bump_homebrew_cask(version: release_version, zip_path: release_zip_path)
    else
      UI.important("GitHub release not published, so the Homebrew cask was not bumped. To finish later:")
      UI.important("  bundle exec fastlane mac github_release version:#{release_version}")
      UI.important("  bundle exec fastlane mac bump_homebrew_cask version:#{release_version}")
    end

    # Open the release folder in Finder
    sh("open '#{RELEASE_DIR}'")
  end

  desc "Write the GitHub release notes for a version: GitHub's generated pull request list grouped " \
       "into features, improvements and bugfixes, each with a short summary written by Claude. " \
       "Options: version, target (commit/branch, default HEAD), previous_tag (default latest release)"
  lane :release_notes do |options|
    version = options[:version] || prompt(text: "Release version (e.g. 1.2.3):")
    target = resolve_release_target(options[:target])
    path = generate_release_notes(version: version, target: target, previous_tag: options[:previous_tag])
    UI.success("📝 Release notes written to #{path}")
    puts File.read(path, encoding: "UTF-8")
    path
  end

  desc "Create the GitHub release v<version> from release/#{ZIP_NAME}.zip after confirming version and " \
       "notes. Reuses release/RELEASE_NOTES-<version>.md if present (regenerate:true to rewrite). " \
       "Options: version, target, previous_tag, regenerate, dry_run. Returns whether it was published"
  lane :github_release do |options|
    version = options[:version] || prompt(text: "Release version (e.g. 1.2.3):")
    dry_run = options[:dry_run] || ENV["DRY_RUN"] == "1"
    ensure_release_publishable(version)
    target = resolve_release_target(options[:target])

    notes_path = release_notes_path(version)
    if options[:regenerate] || !File.exist?(notes_path)
      notes_path = generate_release_notes(version: version, target: target, previous_tag: options[:previous_tag])
    else
      UI.message("📝 Reusing existing #{notes_path}")
    end

    confirm_and_publish_release(version: version, target: target, notes_path: notes_path, dry_run: dry_run)
  end

  desc "Update and push the Homebrew cask (version + sha256) for a given release"
  lane :bump_homebrew_cask do |options|
    cask_version = options[:version] || prompt(text: "Cask version (e.g. 1.2.3):")
    zip_path = options[:zip_path] || File.join(RELEASE_DIR, "#{ZIP_NAME}.zip")

    UI.user_error!("ZIP not found at #{zip_path}") unless File.exist?(zip_path)

    unless File.exist?(HOMEBREW_CASK_FILE)
      UI.important("⚠️  Skipping Homebrew cask update: #{HOMEBREW_CASK_FILE} not found.")
      UI.important("    Clone Heckscheibe/homebrew-tap next to this repo or set HOMEBREW_TAP_PATH, then run: fastlane bump_homebrew_cask version:#{cask_version}")
      next
    end

    require "digest"
    sha = Digest::SHA256.file(zip_path).hexdigest
    UI.message("🔐 SHA256: #{sha}")

    contents = File.read(HOMEBREW_CASK_FILE)
    contents = contents.sub(/version "[^"]*"/, "version \"#{cask_version}\"")
    contents = contents.sub(/sha256 "[^"]*"/, "sha256 \"#{sha}\"")
    contents = add_mcp_binary_stanza(contents)
    File.write(HOMEBREW_CASK_FILE, contents)

    sh("git -C '#{HOMEBREW_TAP_PATH}' add Casks/simple-simulator-manager.rb")
    sh("git -C '#{HOMEBREW_TAP_PATH}' commit -m 'simple-simulator-manager #{cask_version}'")
    sh("git -C '#{HOMEBREW_TAP_PATH}' push")

    UI.success("🍺 Homebrew cask updated to #{cask_version} and pushed.")
    UI.important("ℹ️  Make sure the GitHub release asset SimulatorManager.zip exists for v#{cask_version} so the cask URL resolves (the release lane publishes it first).")
  end

  end
